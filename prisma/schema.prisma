// Printly data model.
// MONEY: every amount is stored as an integer number of paise (₹1 = 100).
// Use formatINR()/toPaise() helpers in app code — never store floats.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  SHOPKEEPER
}

enum ColorMode {
  BW
  COLOR
}

enum Sided {
  SINGLE
  DOUBLE
}

enum PaperSize {
  A4
  A3
}

enum Binding {
  NONE
  STAPLE
  SPIRAL
}

// Shared across print jobs and shop orders.
enum PaymentStatus {
  PENDING // student hasn't submitted a receipt yet
  SUBMITTED // receipt uploaded, awaiting shopkeeper verification
  VERIFIED // shopkeeper confirmed the UPI payment
  REJECTED // receipt didn't match / invalid
}

enum PrintStatus {
  AWAITING_PAYMENT // created, payment not yet verified -> not in queue
  QUEUED
  PRINTING
  READY
  PICKED_UP
  CANCELLED
}

enum OrderStatus {
  AWAITING_PAYMENT
  PENDING // payment verified, being prepared
  READY
  PICKED_UP
  CANCELLED
}

enum NotificationType {
  PAYMENT_VERIFIED
  PAYMENT_REJECTED
  PRINT_READY
  ORDER_READY
  PRINT_PICKED_UP
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         Role     @default(STUDENT)
  createdAt    DateTime @default(now())

  printJobs     PrintJob[]
  orders        ShopOrder[]
  notifications Notification[]
}

// Singleton (id = 1). Drives the student print configurator + shop policies.
model PricingSettings {
  id Int @id @default(1)

  // Per-page rates (paise)
  bwPerPage            Int @default(200) // ₹2.00
  colorPerPage         Int @default(1000) // ₹10.00
  doubleSidedSurcharge Int @default(0) // per page
  a3Surcharge          Int @default(300) // per page

  // Flat add-ons per job (paise)
  stapleFee     Int @default(500)
  spiralFee     Int @default(3000)
  coverPageFee  Int @default(1000)
  rushPercent   Int @default(20) // % uplift when rush selected

  // Policies
  freeSpiralAbove Int @default(0) // paise; 0 = disabled

  acceptingJobs         Boolean @default(true)
  allowCashOnCollection Boolean @default(true)
  autoEmailWhenReady    Boolean @default(true)

  // UPI payment target shown to students
  upiId     String?
  upiQrPath String? // uploaded QR image (relative path under STORAGE_DIR)

  // Shop identity
  shopName     String @default("Printly")
  shopLocation String @default("Campus")

  updatedAt DateTime @updatedAt
}

model PrintJob {
  id        String @id @default(cuid())
  code      String @unique // e.g. "PR-241"
  student   User   @relation(fields: [studentId], references: [id])
  studentId String

  // Document
  fileName  String
  filePath  String // relative path under STORAGE_DIR (private)
  pageCount Int
  copies    Int    @default(1)

  // Print options
  color     ColorMode @default(BW)
  sided     Sided     @default(SINGLE)
  paperSize PaperSize @default(A4)
  binding   Binding   @default(NONE)
  coverPage Boolean   @default(false)
  rush      Boolean   @default(false)

  // Money (paise) — snapshot at submission time
  amount Int

  // Payment (manual UPI)
  paymentStatus PaymentStatus @default(PENDING)
  receiptPath   String?
  upiRef        String? // UTR / transaction reference entered by student
  paidAt        DateTime?

  status PrintStatus @default(AWAITING_PAYMENT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([studentId])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id         String  @id @default(cuid())
  sku        String  @unique // e.g. "P-01"
  name       String
  category   Category @relation(fields: [categoryId], references: [id])
  categoryId String

  price     Int // paise
  stock     Int @default(0)
  reorderAt Int @default(0) // low-stock threshold

  imagePath   String?
  accentColor String? // hex placeholder swatch
  description String?
  isHot       Boolean @default(false)
  isVisible   Boolean @default(true)

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
}

model ShopOrder {
  id        String @id @default(cuid())
  code      String @unique // e.g. "SO-101"
  student   User   @relation(fields: [studentId], references: [id])
  studentId String

  items OrderItem[]
  total Int // paise

  paymentStatus PaymentStatus @default(PENDING)
  receiptPath   String?
  upiRef        String?
  paidAt        DateTime?

  status OrderStatus @default(AWAITING_PAYMENT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([studentId])
}

model OrderItem {
  id        String    @id @default(cuid())
  order     ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product   @relation(fields: [productId], references: [id])
  productId String

  name      String // snapshot of product name
  qty       Int
  unitPrice Int // paise, snapshot
}

model Notification {
  id        String           @id @default(cuid())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      NotificationType
  title     String
  body      String
  linkPath  String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
}

// Generates human-friendly sequential codes (PR-241, SO-101) atomically.
model Counter {
  name  String @id // "print" | "order"
  value Int    @default(0)
}
